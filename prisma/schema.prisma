generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BodyWeightEntry {
  id        Int      @id @default(autoincrement())
  weightLb  Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model NutritionEntry {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())

  calories  Int
  protein   Int
  carbs     Int
  fat       Int

  adherence Int
  notes     String?

  createdAt DateTime @default(now())
}

model RecoveryEntry {
  id           Int      @id @default(autoincrement())
  date         DateTime @default(now())

  sleepHours   Float
  sleepQuality Int

  notes        String?

  createdAt    DateTime @default(now())
}

model Workout {
  id   Int      @id @default(autoincrement())
  name String
  date DateTime @default(now())

  template   WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId Int?

  exercises WorkoutExercise[]

  @@index([templateId])
}

model Exercise {
  id          Int    @id @default(autoincrement())
  name        String @unique
  muscleGroup String @default("Unassigned")

  workouts          WorkoutExercise[]
  templateExercises TemplateExercise[]
}

model WorkoutExercise {
  id Int @id @default(autoincrement())

  workout   Workout @relation(fields: [workoutId], references: [id])
  workoutId Int

  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId Int

  position Int @default(0)

  sets ExerciseSet[]

  @@index([workoutId, position])
  @@index([exerciseId])
}

enum ExerciseSetType {
  REGULAR
  MYOREP
  MYOREP_MATCH
}

model ExerciseSet {
  id Int @id @default(autoincrement())

  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id])
  workoutExerciseId Int

  position  Int             @default(0)
  completed Boolean         @default(true)
  skipped   Boolean         @default(false)
  setType   ExerciseSetType @default(REGULAR)

  weight Float
  reps   Int?
  rir    Float

  @@index([workoutExerciseId, position])
}

model WorkoutTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises TemplateExercise[]
  workouts  Workout[]
}

model TemplateExercise {
  id Int @id @default(autoincrement())

  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int

  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId Int

  position Int @default(0)

  sets TemplateSet[]

  @@index([templateId, position])
  @@index([exerciseId])
}

model TemplateSet {
  id Int @id @default(autoincrement())

  templateExercise   TemplateExercise @relation(fields: [templateExerciseId], references: [id], onDelete: Cascade)
  templateExerciseId Int

  position Int @default(0)
  setType  ExerciseSetType @default(REGULAR)

  targetWeight Float?
  minReps     Int   @default(8)
  maxReps     Int   @default(12)
  targetRir   Float @default(2)

  @@index([templateExerciseId, position])
}